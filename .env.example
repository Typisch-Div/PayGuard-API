# Environment
PROJECT_NAME="Mini Payment Authorization API"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# Server
HOST="0.0.0.0"
PORT=8000

# Database
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="payment_db"
DATABASE_URL="postgresql+asyncpg://postgres:postgres_password@localhost:5432/payment_db"

# Test Database
TEST_DATABASE_URL="postgresql+asyncpg://postgres:postgres_password@localhost:5432/payment_test_db"
